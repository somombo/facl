[
  { "name": "plain path", "request": "GET /files/a", "expect": "allow" },
  { "name": "duplicate slashes are rejected", "request": "GET //files//a", "expect": "deny", "reason": "bad_request_path" },
  { "name": "a trailing slash is rejected", "request": "GET /files/a/", "expect": "deny", "reason": "bad_request_path" },
  { "name": "many trailing slashes are rejected", "request": "GET /files/a///", "expect": "deny", "reason": "bad_request_path" },
  { "name": "%61 decodes to a", "request": "GET /files/%61", "expect": "allow" },
  { "name": "hex digits are case-insensitive", "request": "GET /uni/%c3%A9", "expect": "allow" },
  { "name": "decoded exactly once", "request": "GET /files/%2561", "expect": "deny", "reason": "conditions_not_met" },
  { "name": "matching is case-sensitive", "request": "GET /Files/a", "expect": "deny", "reason": "no_matching_rule" },
  { "name": "literal segments with dots and tildes", "request": "GET /v1.0/items-x~y/1", "expect": "allow" },
  { "name": "two nested captures", "request": "GET /orgs/acme/members/bob", "expect": "allow" },
  { "name": "two nested captures, wrong member", "request": "GET /orgs/acme/members/eve", "expect": "deny", "reason": "conditions_not_met" },
  { "name": "too few segments", "request": "GET /files", "expect": "deny", "reason": "no_matching_rule" },
  { "name": "too many segments", "request": "GET /files/a/b", "expect": "deny", "reason": "no_matching_rule" },

  { "name": "dot-dot is rejected", "request": "GET /files/..", "expect": "deny", "reason": "bad_request_path" },
  { "name": "dot is rejected", "request": "GET /files/.", "expect": "deny", "reason": "bad_request_path" },
  { "name": "dot-dot in the middle is rejected", "request": "GET /files/../admin", "expect": "deny", "reason": "bad_request_path" },
  { "name": "%2e%2e is rejected", "request": "GET /files/%2e%2e", "expect": "deny", "reason": "bad_request_path" },
  { "name": "%2E%2E is rejected", "request": "GET /deep/%2E%2E/admin", "expect": "deny", "reason": "bad_request_path" },
  { "name": "%2F is rejected", "request": "GET /files/a%2Fb", "expect": "deny", "reason": "bad_request_path" },
  { "name": "%FF is invalid UTF-8", "request": "GET /files/%FF", "expect": "deny", "reason": "bad_request_path" },
  { "name": "truncated UTF-8 is invalid", "request": "GET /files/%C3", "expect": "deny", "reason": "bad_request_path" },
  { "name": "overlong UTF-8 is invalid", "request": "GET /files/%C0%AF", "expect": "deny", "reason": "bad_request_path" },
  { "name": "%00 is rejected", "request": "GET /files/a%00", "expect": "deny", "reason": "bad_request_path" },
  { "name": "bad hex digits are rejected", "request": "GET /files/%zz", "expect": "deny", "reason": "bad_request_path" },
  { "name": "truncated escape is rejected", "request": "GET /files/a%4", "expect": "deny", "reason": "bad_request_path" },
  { "name": "a path must start with a slash", "request": "GET files/a", "expect": "deny", "reason": "bad_request_path" },
  { "name": "a query string is rejected", "request": "GET /files/a?x=1", "expect": "deny", "reason": "bad_request_path" },
  { "name": "a fragment is rejected", "request": "GET /files/a#x", "expect": "deny", "reason": "bad_request_path" },

  { "name": "** binds a list of two segments", "request": "GET /deep/a/b.txt", "expect": "allow" },
  { "name": "** with one segment", "request": "GET /deep/a", "expect": "deny", "reason": "conditions_not_met" },
  { "name": "** with three segments", "request": "GET /deep/a/b.txt/c", "expect": "deny", "reason": "conditions_not_met" },
  { "name": "** matches zero segments", "request": "GET /zero", "expect": "allow" },
  { "name": "** with a trailing slash is rejected", "request": "GET /zero/", "expect": "deny", "reason": "bad_request_path" },
  { "name": "** with one segment is not empty", "request": "GET /zero/a", "expect": "deny", "reason": "conditions_not_met" },

  { "name": "a parent's allow applies to its own path", "request": "GET /users/ann", "expect": "allow" },
  { "name": "rules don't cascade down", "request": "GET /users/ann/posts/1", "expect": "deny", "reason": "no_allow_for_method" },
  { "name": "a child's allow applies to its own path", "request": "PUT /users/ann/posts/1", "expect": "allow" },
  { "name": "a child's allow does not reach up", "request": "PUT /users/ann", "expect": "deny", "reason": "no_allow_for_method" },
  { "name": "an unknown child path", "request": "GET /users/ann/other", "expect": "deny", "reason": "no_matching_rule" },
  { "name": "the root pattern matches /", "request": "GET /", "expect": "allow" },
  { "name": "// is not the root", "request": "GET //", "expect": "deny", "reason": "bad_request_path" },
  { "name": "the root pattern grants only get", "request": "POST /", "expect": "deny", "reason": "no_allow_for_method" }
]
