[
  { "name": "size of a string counts code points", "request": "GET /size-string", "context": { "s": "héé" }, "expect": "allow" },
  { "name": "size of a string, wrong length", "request": "GET /size-string", "context": { "s": "ab" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "x.size() on a string", "request": "GET /size-method", "context": { "s": "abc" }, "expect": "allow" },
  { "name": "size of a list", "request": "GET /size-list", "context": { "l": ["x", "y"] }, "expect": "allow" },
  { "name": "size of a list, wrong length", "request": "GET /size-list", "context": { "l": [] }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "size of a map", "request": "GET /size-map", "context": { "m": { "a": 1, "b": 2 } }, "expect": "allow" },
  { "name": "size of an int is a type mismatch", "request": "GET /size-int", "context": { "n": 1 }, "expect": "deny", "reason": "conditions_not_met" },

  { "name": "startsWith", "request": "GET /starts", "context": { "s": "abc" }, "expect": "allow" },
  { "name": "startsWith, no", "request": "GET /starts", "context": { "s": "xab" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "startsWith, string shorter than the prefix", "request": "GET /starts", "context": { "s": "a" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "endsWith", "request": "GET /ends", "context": { "s": "wxyz" }, "expect": "allow" },
  { "name": "endsWith, no", "request": "GET /ends", "context": { "s": "yzx" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "startsWith on an int is a type mismatch", "request": "GET /starts-int", "context": { "n": 1 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "startsWith on request.path", "request": "GET /starts-path", "expect": "allow" },

  { "name": "has() on a present key", "request": "GET /has", "context": { "flag": false }, "expect": "allow" },
  { "name": "has() on a missing key", "request": "GET /has", "context": {}, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "has() on a present nested key", "request": "GET /has-null", "auth": { "uid": "a" }, "expect": "allow" },
  { "name": "has() on null is a type mismatch", "request": "GET /has-null", "expect": "deny", "reason": "conditions_not_met" },

  { "name": "in a list", "request": "GET /in-list", "auth": { "uid": "b" }, "expect": "allow" },
  { "name": "not in a list", "request": "GET /in-list", "auth": { "uid": "c" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "in a map tests keys", "request": "GET /in-map", "context": { "m": { "k": 0 } }, "expect": "allow" },
  { "name": "not in a map", "request": "GET /in-map", "context": { "m": { "j": 0 } }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "a non-string key in a map is a type mismatch", "request": "GET /in-map-int", "context": { "m": { "1": 0 } }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "in an int is a type mismatch", "request": "GET /in-int", "context": { "n": 1 }, "expect": "deny", "reason": "conditions_not_met" },

  { "name": "request.is json with parameters", "request": "GET /is-json", "headers": { "Content-Type": "application/json; charset=utf-8" }, "expect": "allow" },
  { "name": "request.is json, +json suffix", "request": "GET /is-json", "headers": { "content-type": "Application/Vnd.Api+JSON" }, "expect": "allow" },
  { "name": "request.is json, wrong type", "request": "GET /is-json", "headers": { "Content-Type": "text/plain" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "request.is json, no header", "request": "GET /is-json", "expect": "deny", "reason": "conditions_not_met" },
  { "name": "request.is with type/*", "request": "GET /is-wild", "headers": { "Content-Type": "application/xml" }, "expect": "allow" },
  { "name": "request.is with type/subtype", "request": "GET /is-exact", "headers": { "Content-Type": "text/csv; charset=utf-8" }, "expect": "allow" },
  { "name": "request.is with an unknown name is an error", "request": "GET /is-bogus", "headers": { "Content-Type": "application/json" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "request.is with an unknown name and no header is an error", "request": "GET /is-bogus", "expect": "deny", "reason": "conditions_not_met" },
