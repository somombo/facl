  { "name": "int comparison, lower bound exclusive", "request": "GET /cmp-int", "context": { "n": 5 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "int comparison, excluded value", "request": "GET /cmp-int", "context": { "n": 7 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "int comparison, too big", "request": "GET /cmp-int", "context": { "n": 11 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "negative ints", "request": "GET /cmp-neg", "context": { "n": -3 }, "expect": "allow" },
  { "name": "negative ints, out of range", "request": "GET /cmp-neg", "context": { "n": -4 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "the smallest i64 literal", "request": "GET /cmp-min", "context": { "n": -9223372036854775807 }, "expect": "allow" },
  { "name": "string comparisons are bytewise", "request": "GET /cmp-str", "context": { "s": "q" }, "expect": "allow" },
  { "name": "string comparison, upper bound exclusive", "request": "GET /cmp-str", "context": { "s": "z" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "uppercase sorts before lowercase", "request": "GET /cmp-str", "context": { "s": "Q" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "false < true", "request": "GET /cmp-bool", "context": { "b": true }, "expect": "allow" },
  { "name": "false < false", "request": "GET /cmp-bool", "context": { "b": false }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "values of different types are unequal", "request": "GET /eq-types", "context": { "n": 1 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "!= on different types is true, not an error", "request": "GET /neq-types", "context": { "n": 1 }, "expect": "allow" },
  { "name": "null equals null", "request": "GET /eq-null", "context": { "x": null }, "expect": "allow" },
  { "name": "list equality", "request": "GET /eq-list", "context": { "l": ["x", "y"] }, "expect": "allow" },
  { "name": "list equality respects order", "request": "GET /eq-list", "context": { "l": ["y", "x"] }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "map equality ignores entry order", "request": "GET /map-eq", "context": { "a": { "p": 1, "q": [true] }, "b": { "q": [true], "p": 1 } }, "expect": "allow" },
  { "name": "map equality compares values", "request": "GET /map-eq", "context": { "a": { "p": 1 }, "b": { "p": 2 } }, "expect": "deny", "reason": "conditions_not_met" },

  { "name": "ordering an int against a string is a type mismatch", "request": "GET /mismatch-cmp", "context": { "n": 1 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "! on an int is a type mismatch", "request": "GET /mismatch-not", "context": { "n": 1 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "a string condition grants nothing", "request": "GET /mismatch-str", "context": { "s": "true" }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "ordering null is a type mismatch", "request": "GET /mismatch-null", "context": { "x": null }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "an int && true is a type mismatch", "request": "GET /mismatch-and", "context": { "n": 1 }, "expect": "deny", "reason": "conditions_not_met" },

  { "name": "list index", "request": "GET /index-list", "context": { "l": ["x", "y"] }, "expect": "allow" },
  { "name": "list index out of range", "request": "GET /index-list", "context": { "l": ["x"] }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "map index", "request": "GET /index-key", "context": { "m": { "k": 1 } }, "expect": "allow" },
  { "name": "map index, missing key", "request": "GET /index-key", "context": { "m": {} }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "indexing a list by a string is a type mismatch", "request": "GET /index-type", "context": { "l": [1] }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "a negative list index is out of range", "request": "GET /index-var", "context": { "l": ["x", "y"], "i": -1 }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "a computed list index", "request": "GET /index-var", "context": { "l": ["x", "y"], "i": 1 }, "expect": "allow" },

  { "name": "request.method and request.path", "request": "GET /fields/x", "expect": "allow" },
  { "name": "request.path is canonical", "request": "GET /fields/%78", "expect": "allow" },
  { "name": "header names are lower-cased", "request": "GET /header", "headers": { "X-Token": "abc" }, "expect": "allow" },
  { "name": "a missing header is an error", "request": "GET /header", "expect": "deny", "reason": "conditions_not_met" },
  { "name": "nested selects", "request": "GET /select", "auth": { "uid": "a", "token": { "admin": true } }, "expect": "allow" },
  { "name": "nested selects, not admin", "request": "GET /select", "auth": { "uid": "a", "token": { "admin": false } }, "expect": "deny", "reason": "conditions_not_met" },
  { "name": "parentheses and !", "request": "GET /parens", "context": { "n": 1 }, "expect": "allow" },
  { "name": "parentheses and !, second operand", "request": "GET /parens", "context": { "n": 2 }, "expect": "deny", "reason": "conditions_not_met" }
